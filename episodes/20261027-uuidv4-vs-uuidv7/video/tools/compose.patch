+// "shades" theme end card: the last frame of the shades title card (pink + rays + elephant,
+// script wordmark, Lato title with the plum band), static, its text layers sliding in.
+export async function shadesCard(work: string, name: string, w: number, h: number, title: string, hosts: { name: string; company?: string }[]): Promise<{ bg: string; layers: Layer[] }> {
+  const [l1, l2 = ""] = title.split("\n");
