+.a{position:absolute}.t{font-family:Lato;font-weight:900;font-size:150px;line-height:1;color:#fff;letter-spacing:-2px;text-shadow:0 7px 0 ${SHADES.plum}55,0 0 40px rgba(120,20,120,.25);width:1000px}
+.band{font-family:Lato;font-weight:900;font-size:124px;line-height:150px;height:150px;color:#fff;letter-spacing:-1px;white-space:nowrap;padding:0 46px 0 14px;position:absolute}.band:before{content:"";position:absolute;z-index:-1;left:-24px;top:0;right:0;height:150px;background:${SHADES.plum};border-radius:18px;transform:skewX(-6deg);box-shadow:0 10px 0 rgba(61,15,69,.25)}.band i{font-style:normal;color:#ff9cf0}
+.who{font-family:Lato;font-weight:700;font-size:50px;line-height:1.12;color:${SHADES.plum}}.who span{font-weight:400;color:${SHADES.sub}}
+</style></head><body>${body}</body></html>`;
+  const k = 950 / 1536;
+  const bg = join(work, `${name}-bg.png`);
+  copyFileSync(join(BRAND, "brand-card-bg.png"), bg);
+  const parts = [
+    { st: 0.3, html: `<img class="a" src="file://${BRAND}/wordmark-white.png" style="left:61px;top:70px;width:700px;filter:drop-shadow(0 6px 0 rgba(61,15,69,.35))">` },
+    { st: 0.6, html: `<div class="a t" style="left:110px;top:330px">${l1.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</div>` },
+    { st: 0.9, html: `<div class="a band" style="left:110px;top:656px">${l2.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/\?$/, "<i>?</i>")}</div>` },
+    { st: 1.2, html: `<div class="a who" style="left:116px;top:905px">${hosts.map((p) => `${p.name}${p.company ? `<span>&nbsp;&middot;&nbsp;${p.company}</span>` : ""}`).join("<br>")}</div>` },
+  ];
+  const layers: Layer[] = [];
+  for (const [i, p] of parts.entries()) {
+    const png = join(work, `${name}-l${i}.png`);
+    if (i === 0) copyFileSync(join(BRAND, "brand-card-wordmark.png"), png);
+    else await renderHtml(doc(p.html), w, h, png);
+    layers.push({ png, st: p.st, d: 0.7, dy: 24 });
+  }
+  return { bg, layers };
+}
